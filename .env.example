# Sentry Configuration
# --------------------
# EXPO_PUBLIC_SENTRY_DSN: The Sentry DSN (Data Source Name) for your project.
# Safe to include in client-side bundles (Expo automatically embeds EXPO_PUBLIC_* variables).
# Find this in Sentry: Project Settings -> Client Keys (DSN).
# Example: https://abc123xyz@o123456.ingest.us.sentry.io/7890123
EXPO_PUBLIC_SENTRY_DSN=

# SENTRY_AUTH_TOKEN: Used at build time (e.g. Metro / EAS Build) to upload source maps
# and native debug symbols to Sentry.
# DO NOT commit real tokens to git.
# Find or create this in Sentry: Settings -> Developer Settings -> Auth Tokens (scope: project:releases, org:read).
# Example: sntrys_1234567890abcdef...
SENTRY_AUTH_TOKEN=
