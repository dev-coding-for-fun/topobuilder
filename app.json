{
  "expo": {
    "name": "Bolted",
    "slug": "topobuilder",
    "scheme": "topobuilder",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "experiments": {
      "reactCompiler": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bowvalleydev.topobuilder",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Bolted uses the camera to capture rock face photos for offline topo markup.",
        "NSPhotoLibraryUsageDescription": "Bolted imports rock face photos so you can mark up climbing routes offline.",
        "UIBackgroundModes": [
          "processing",
          "fetch"
        ]
      }
    },
    "android": {
      "permissions": [
        "android.permission.CAMERA"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.bowvalleydev.topobuilder",
      "versionCode": 1
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-asset",
      [
        "expo-font",
        {
          "fonts": [
            "node_modules/@expo-google-fonts/inter/400Regular/Inter_400Regular.ttf",
            "node_modules/@expo-google-fonts/inter/700Bold/Inter_700Bold.ttf",
            "node_modules/@expo-google-fonts/inter/800ExtraBold/Inter_800ExtraBold.ttf",
            "node_modules/@expo-google-fonts/inter/900Black/Inter_900Black.ttf"
          ]
        }
      ],
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-status-bar",
      "expo-image",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Bolted uses the camera to capture rock face photos for offline topo markup.",
          "microphonePermission": false,
          "photosPermission": "Bolted imports rock face photos so you can mark up climbing routes offline."
        }
      ],
      "expo-background-task",
      "expo-notifications",
      "expo-updates",
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "bolted-app",
          "organization": "tabvar-k0"
        }
      ]
    ],
    "updates": {
      "url": "https://u.expo.dev/af515901-0cc7-42ee-98bd-be3f1de39aa1",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "af515901-0cc7-42ee-98bd-be3f1de39aa1"
      }
    },
    "owner": "bowvalleydev"
  }
}